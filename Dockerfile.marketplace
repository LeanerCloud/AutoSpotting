FROM golang:alpine as golang
ARG savings_cut
ARG flavor=stable

RUN apk add -U --no-cache ca-certificates git make

COPY go.mod go.sum /src/
# Download dependencies
WORKDIR /src
RUN go mod download

COPY . /src

RUN FLAVOR=$flavor CGO_ENABLED=0 SAVINGS_CUT=$savings_cut make

FROM alpine:latest
COPY LICENSE BINARY_LICENSE THIRDPARTY /
RUN apk add -U --no-cache ca-certificates tzdata
COPY --from=golang /src/AutoSpotting .
ENTRYPOINT ["./AutoSpotting"]
